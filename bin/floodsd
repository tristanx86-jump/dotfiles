#!/usr/bin/env bash
# floodsd ("flood standalone") — standalone remote load-generator.
#
# A deliberately different name from `floodfd` (the zsh function in
# zsh/firedancer-flood.zsh) so the two can coexist on the same machine
# without colliding: same behavior and on-disk state format, ported to
# plain bash — no zsh, no dotfiles, nothing sourced into any shell config.
# Works from bash or zsh (or any shell) since it's a normal executable, not
# a sourced function, and works on any distro with bash, `ip`, and (for
# `floodsd dpdk`) apt/dnf/yum.
#
# Load-tests a remote firedancer validator from a *separate* box: always
# sends 64B (min-sized) UDP packets to dport 9000, or 8003 with `shred`.
# The default source port (8424, see FLOOD_SPORT below) pins the flood to one
# of the target's RX queues / net tiles. Pass --multiport to `floodsd setup`
# / `floodsd kernel` to instead rotate the src port across a small range
# (FLOOD_SPORT..FLOOD_SPORT+FLOOD_SPORT_CNT-1) so the target's NIC hashes the
# flood across all its RX queues / net tiles. Every source port used must be
# egress-allowed by this box's firewall. Two engines, chosen explicitly each
# run:
#   floodsd dpdk    DPDK pktgen (userspace, needs a NIC bound to vfio-pci/mlx5)
#   floodsd kernel  in-kernel pktgen module (no DPDK/hugepages needed)
#
# Bonded NICs: both the bond master and its slaves work as a `floodsd setup`
# target, but a slave alone can't resolve the target's MAC — bonding's RX
# handler reassigns every inbound skb it receives (ARP/probe replies
# included) to the bond master's netdevice, so a slave never sees its own
# replies. `setup` detects this and probes via the master instead when a
# slave is picked, while still recording the slave itself as what floods
# later (see the bondmaster/probeif handling in _floodsd_setup). Conversely,
# neither flood engine can drive a bond master directly — `floodsd dpdk`
# needs a real PCI device and `floodsd kernel` needs a real per-queue
# hardware TX ring, and a bond is a purely software netdevice with neither
# (pktgen driving one directly tends to surface as skb/protocol errors
# rather than a clean failure) — so if the saved target is a bond master,
# both engines prompt for one of its slaves to actually flood from instead
# (see _fd_bond_pick_slave). mlx5 members stay attached to the bond, with
# Pktgen receive isolation enabled before port configuration.
#
# `floodsd setup` resolves and saves the target once: pick the sending NIC,
# enter the destination IP, then floodsd sends it a UDP probe (source port
# pinned to $FLOOD_SPORT — ICMP ping has no source port to pin, so it's
# dropped outbound by this box's egress firewall even though inbound ICMP
# works) and reads the resolved MAC out of the neighbor table, which doubles
# as a reachability check before you start flooding. Enter keeps the last
# value at every subsequent prompt. Works whether the target is on-link or a
# routed hop away (see _fd_nexthop_ip) — when routed, the router's MAC gets
# resolved and used at L2 while the target's real IP still goes in the IP
# header, exactly like normal routing.
#
# `floodsd setup-srcport` overrides the default source port (8424) if this
# box's egress firewall pins a different one — run it before `floodsd setup`
# on a box where the default doesn't get probes out.
#
# `floodsd diagnose` is a read-only, opt-in health check (link state, route/
# next-hop, rp_filter, python3, a best-effort firewall-rule grep) — nothing
# else in floodsd calls it, so it's only there when you go looking for it.
#
# `floodsd kernel` drops you into an interactive prompt (start / start
# <mpps|max> / stop / quit) rather than a one-shot run — see its own header
# comment below for the command set.

set -uo pipefail

FLOOD_DPORT=9000  # target port on the validator under test
FLOOD_SPORT=8424  # base source port everything egresses from — override per-box with `floodsd setup-srcport` if this box's egress firewall pins a different port
# Source-port rotation is OPT-IN (default: a single source port). Pass
# --multiport to `floodsd setup` / `floodsd kernel` to rotate the src port
# across FLOOD_SPORT_CNT consecutive ports (FLOOD_SPORT ..
# FLOOD_SPORT+FLOOD_SPORT_CNT-1). The receiver's NIC hashes the UDP 5-tuple
# (incl. src port) to pick an RX queue, so varying the src port spreads the
# flood across the target's net tiles instead of pinning it to one; a single
# port pins the whole flood to one RX queue / net tile. Every port used must
# be egress-allowed by this box's firewall. FLOOD_SPORT_CNT only takes effect
# in --multiport mode; the default is always one port.
FLOOD_SPORT_CNT=100

# Runtime toggle for the source-port rotation above. Off by default (single
# port); `--multiport` on `floodsd setup`/`floodsd kernel` flips it on for
# that invocation. _fd_sport_cnt is the effective port count everything else
# reads: the full FLOOD_SPORT_CNT range when multiport is on, otherwise 1.
FLOOD_MULTIPORT=0
_fd_parse_multiport() {
    local a
    for a in "$@"; do
        [ "$a" = "--multiport" ] && FLOOD_MULTIPORT=1
    done
}
_fd_sport_cnt() {
    if [ "$FLOOD_MULTIPORT" = 1 ]; then echo "${FLOOD_SPORT_CNT:-1}"; else echo 1; fi
}

_fd_parse_dport() {
    local a
    for a in "$@"; do
        if [ "$a" = shred ]; then
            FLOOD_DPORT=8003
        fi
    done
}

FLOODSD_STATE_DIR="$HOME/.config/floodsd"
FLOODSD_STATE_FILE="$FLOODSD_STATE_DIR/state"
FLOODSD_VFIO_STATE="$FLOODSD_STATE_DIR/vfio-state"
FLOODSD_BOND_STATE="$FLOODSD_STATE_DIR/bond-state"
FLOODSD_DPDK_CMDS="$FLOODSD_STATE_DIR/dpdk.pkt"
_floodsd_get() { grep "^$1=" "$FLOODSD_STATE_FILE" 2>/dev/null | cut -d= -f2-; }
_floodsd_set() {
    local key=$1 val=$2
    mkdir -p "$(dirname "$FLOODSD_STATE_FILE")"
    local tmp="${FLOODSD_STATE_FILE}.tmp"
    { [ -f "$FLOODSD_STATE_FILE" ] && grep -v "^$key=" "$FLOODSD_STATE_FILE"; printf '%s=%s\n' "$key" "$val"; } > "$tmp"
    mv "$tmp" "$FLOODSD_STATE_FILE"
}

# The egress-allowed source port varies by box (whatever its firewall pins),
# so a saved override (see `floodsd setup-srcport`) always beats the
# FLOOD_SPORT default above.
_fd_saved_sport=$(_floodsd_get sport)
[ -n "$_fd_saved_sport" ] && FLOOD_SPORT=$_fd_saved_sport

# ── Shared DPDK/NIC helpers ───────────────────────────

# _fd_bond_tag <iface>: prints a bracketed annotation for _fd_pick_iface —
# "[bond, mode <N>, slaves: a,b]" if <iface> is a bonding master, "[bonded
# slave of <bond>]" if it's enslaved, or "" otherwise.
_fd_bond_tag() {
    local iface=$1 mode slaves master
    if [ -d "/sys/class/net/$iface/bonding" ]; then
        mode=$(awk '{print $1}' "/sys/class/net/$iface/bonding/mode" 2>/dev/null)
        slaves=$(cat "/sys/class/net/$iface/bonding/slaves" 2>/dev/null | tr ' ' ',')
        echo "[bond${mode:+, mode $mode}${slaves:+, slaves: $slaves}]"
        return
    fi
    master=$(readlink "/sys/class/net/$iface/master" 2>/dev/null)
    [ -n "$master" ] && echo "[bonded slave of ${master##*/}]"
}

# _fd_pick_iface <prefix> <label> [current]: list network interfaces and
# prompt for one, printing the choice to stdout. Enter keeps [current] if given.
# Bonding masters and their slaves are both listed (see _fd_bond_tag), and
# either is a fine choice here — `floodsd setup` resolves via the bond
# master either way (a slave alone can't see its own inbound replies), and
# `floodsd kernel`/`floodsd dpdk` will prompt for one of the bond's slaves at
# flood time if the saved target turns out to be the master itself (see
# _fd_bond_pick_slave and the bond handling in _floodsd_kernel/_floodsd_dpdk).
_fd_pick_iface() {
    local prefix=$1 label=$2 cur=$3
    local ifaces=() i idx=1 drv bondtag state statetag
    echo "Available interfaces:" >&2
    for i in /sys/class/net/*; do
        [ -d "$i" ] || continue
        i=${i##*/}
        [ "$i" = lo ] && continue
        drv=$(basename "$(readlink -f "/sys/class/net/$i/device/driver" 2>/dev/null)" 2>/dev/null)
        bondtag=$(_fd_bond_tag "$i")
        # Only flag non-"up" state — healthy interfaces stay quiet, so this
        # doesn't clutter the picker for the common case.
        state=$(cat "/sys/class/net/$i/operstate" 2>/dev/null)
        statetag=""; [ -n "$state" ] && [ "$state" != up ] && statetag="($state) "
        ifaces+=("$i")
        printf "  %d) %-20s %s\n" "$idx" "$i" "${statetag}${drv:+driver: $drv }${bondtag}" >&2
        idx=$((idx + 1))
    done
    if [ "${#ifaces[@]}" -eq 0 ]; then
        echo "$prefix: no network interfaces found." >&2
        return 1
    fi

    local sel
    read -rp "${label}${cur:+ (Enter = keep '$cur')} [1-${#ifaces[@]}]: " sel
    if [ -z "$sel" ]; then
        [ -z "$cur" ] && { echo "$prefix: no interface selected." >&2; return 1; }
        echo "$cur"
        return 0
    fi
    if ! [[ "$sel" =~ ^[0-9]+$ ]] || [ "$sel" -lt 1 ] || [ "$sel" -gt "${#ifaces[@]}" ]; then
        echo "$prefix: invalid selection '$sel'." >&2
        return 1
    fi
    echo "${ifaces[$((sel - 1))]}"
}

# _fd_lcore_plan selects the highest available CPUs for DPDK.
# Logical lcores are contiguous even when the permitted CPUs have gaps.
_fd_lcore_plan() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo "$1: python3 is required to select available CPUs." >&2
        return 1
    fi
    python3 - "$1" "$2" "${3:-1}" <<'PYEOF'
import os, sys

prefix, tx_cnt, port_cnt = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
cpus = sorted(os.sched_getaffinity(0))
core_cnt = tx_cnt + port_cnt + 1
if port_cnt < 1 or tx_cnt < port_cnt:
    sys.exit(f"{prefix}: each selected port needs at least one TX core.")
if core_cnt > len(cpus) or core_cnt > 128:
    sys.exit(f"{prefix}: need {core_cnt} available CPUs, but only {min(len(cpus), 128)} can be used. Choose fewer TX cores.")

selected = list(reversed(cpus[-core_cnt:]))
lcores = ','.join(f'{lid}@{cpu}' for lid, cpu in enumerate(selected))
mapping, tx_start = [], port_cnt + 1
for port in range(port_cnt):
    tx_queues = tx_cnt // port_cnt + (port < tx_cnt % port_cnt)
    tx_end = tx_start + tx_queues - 1
    tx_range = str(tx_start) if tx_start == tx_end else f'{tx_start}-{tx_end}'
    mapping.append(f'[{port + 1}:{tx_range}].{port}')
    tx_start = tx_end + 1
cpu_list = ','.join(str(cpu) for cpu in selected)
print(lcores, ','.join(mapping), cpu_list, tx_cnt * 30)
PYEOF
}

# _fd_check_numa checks the selected CPUs against the NIC's NUMA node.
_fd_check_numa() {
    local prefix=$1 iface=$2 nicnode=$3 lcores=$4
    if [ -z "$nicnode" ] || [ "$nicnode" = "-1" ]; then return 0; fi
    local c cnode badcores="" n
    for c in ${lcores//,/ }; do
        cnode=""
        for n in /sys/devices/system/cpu/cpu$c/node*; do
            [ -e "$n" ] || continue
            cnode=${n##*/node}
        done
        [ -n "$cnode" ] && [ "$cnode" != "$nicnode" ] && badcores="${badcores} $c"
    done
    if [ -n "$badcores" ]; then
        echo "$prefix: WARNING — $iface is on NUMA node $nicnode but core(s)$badcores are on another node."
        echo "  Cross-socket DMA will skew results; pin to cores on node $nicnode for accurate numbers."
    fi
}

# _fd_reserve_hugepages <ntx>: reserves 1024 x 2MB hugepages per TX core and
# mounts a 2MB hugetlbfs at /mnt/huge if one isn't already mounted.
_fd_reserve_hugepages() {
    local ntx=$1
    local npages=$(( 1024 * ntx ))
    local current available required
    current=$(cat /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages) || return 1
    available=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo) || return 1
    [[ "$current" =~ ^[0-9]+$ && "$available" =~ ^[0-9]+$ ]] || return 1
    required=$(( (npages - current) * 2048 ))
    if [ "$required" -gt 0 ]; then
        if [ "$required" -gt "$((available * 3 / 4))" ] || [ "$((available - required))" -lt 1048576 ]; then
            echo "floodsd dpdk: insufficient memory headroom for $((npages * 2)) MiB of hugepages." >&2
            return 1
        fi
        echo "Reserving $npages x 2MB hugepages ($((npages * 2)) MiB)..."
        echo "$npages" | sudo tee /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages >/dev/null || return 1
        current=$(cat /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages) || return 1
        [ "$current" -ge "$npages" ] || { echo "floodsd dpdk: hugepage allocation was incomplete." >&2; return 1; }
    fi
    if ! grep -q 'hugetlbfs.*pagesize=2M' /proc/mounts; then
        sudo mkdir -p /mnt/huge && sudo mount -t hugetlbfs -o pagesize=2M nodev /mnt/huge || return 1
    fi
}

# _fd_vfio_bind <tool> <iface> <pci> <curdrv> <statefile> [peer] [ip]: binds
# <iface> to vfio-pci for DPDK and records pci/drv/if/ip/peer in <statefile>
# so _fd_vfio_restore can undo it later. Only call this for non-Mellanox
# NICs, mlx5 never needs rebinding.
_fd_vfio_bind() {
    local tool=$1 iface=$2 pci=$3 curdrv=$4 state=$5 peer=$6 ip=$7
    if ! [[ "$pci" =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]$ ]] ||
       [ ! -d "/sys/bus/pci/devices/$pci" ] || [ -z "$curdrv" ] || [ -e "$state" ]; then
        echo "$tool: invalid PCI device or existing VFIO ownership record." >&2
        return 1
    fi
    case "$curdrv" in mlx5_core|mlx5) echo "$tool: refusing to bind mlx5 to vfio-pci." >&2; return 1 ;; esac
    echo "Binding $iface ($pci, ${curdrv:-unknown}) to vfio-pci for DPDK..."
    sudo modprobe vfio-pci || return 1
    if ! ls /sys/kernel/iommu_groups/* >/dev/null 2>&1; then
        echo "$tool: vfio-pci requires an enabled IOMMU." >&2
        return 1
    fi
    mkdir -p "$(dirname "$state")" || return 1
    printf 'pci=%s\ndrv=%s\nif=%s\nip=%s\npeer=%s\n' "$pci" "$curdrv" "$iface" "$ip" "$peer" > "$state" || return 1
    if command -v dpdk-devbind.py >/dev/null 2>&1; then
        sudo dpdk-devbind.py --bind=vfio-pci "$pci" || return 1
    else
        echo vfio-pci | sudo tee "/sys/bus/pci/devices/$pci/driver_override" >/dev/null || return 1
        echo "$pci" | sudo tee "/sys/bus/pci/devices/$pci/driver/unbind" >/dev/null || return 1
        echo "$pci" | sudo tee /sys/bus/pci/drivers_probe >/dev/null || return 1
    fi
    [ "$(basename "$(readlink "/sys/bus/pci/devices/$pci/driver")")" = vfio-pci ] || return 1
    echo "  To rebind the kernel driver + restore $iface later:  $tool restore"
}

# _fd_vfio_restore <prefix> <statefile>: undoes _fd_vfio_bind — rebinds the
# interface to its kernel driver, renames the reborn netdev back, restores
# its IP, and bounces a peer interface if one was recorded.
_fd_vfio_restore() {
    local prefix=$1 state=$2
    if [ ! -f "$state" ]; then
        echo "$prefix: no saved state ($state) — nothing was bound to vfio-pci."
        return 1
    fi

    local pci drv iface ip peer k v
    while IFS='=' read -r k v; do
        case "$k" in
            pci) pci=$v ;; drv) drv=$v ;;
            if)  iface=$v ;; ip) ip=$v ;; peer) peer=$v ;;
        esac
    done < "$state"
    if [ -z "$pci" ]; then
        echo "$prefix: state file is malformed; remove $state and re-run setup."
        return 1
    fi

    echo "Rebinding $pci to kernel driver '${drv:-?}'..."
    if command -v dpdk-devbind.py >/dev/null 2>&1 && [ -n "$drv" ]; then
        sudo dpdk-devbind.py --bind="$drv" "$pci"
    else
        echo "$pci" | sudo tee /sys/bus/pci/drivers/vfio-pci/unbind >/dev/null 2>&1
        echo "" | sudo tee "/sys/bus/pci/devices/$pci/driver_override" >/dev/null
        if [ -n "$drv" ] && [ -d "/sys/bus/pci/drivers/$drv" ]; then
            echo "$pci" | sudo tee "/sys/bus/pci/drivers/$drv/bind" >/dev/null 2>&1
        fi
        echo "$pci" | sudo tee /sys/bus/pci/drivers_probe >/dev/null 2>&1
    fi

    # The kernel re-creates the netdev under a fresh name; rename it back.
    local newname="" n
    for n in /sys/bus/pci/devices/$pci/net/*; do
        [ -e "$n" ] || continue
        newname=${n##*/}
    done
    if [ -z "$newname" ]; then
        echo "$prefix: device rebound but no netdev appeared for $pci."
        echo "  Check 'ip link'; you may need to re-run, or driver '$drv' failed to attach."
        return 1
    fi
    iface=${iface:-$newname}
    if [ "$newname" != "$iface" ]; then
        echo "Renaming '$newname' -> '$iface'..."
        sudo ip link set "$newname" down && \
        sudo ip link set "$newname" name "$iface"
    fi
    sudo ip link set "$iface" up

    if [ -n "$ip" ] && ! ip -4 -o addr show dev "$iface" | grep -q "${ip%%/*}"; then
        echo "Re-adding $ip to $iface (lost when the netdev was destroyed)..."
        sudo ip addr add "$ip" dev "$iface"
    fi
    if [ -n "$peer" ] && ip link show "$peer" >/dev/null 2>&1; then
        echo "Bouncing $peer to re-establish carrier on the loopback link..."
        sudo ip link set "$peer" down && sudo ip link set "$peer" up
    fi

    rm -f "$state"
    echo "Done — $iface is back on the kernel driver."
    [ -n "$peer" ] && echo "  $peer link restored."
}

# _fd_bond_reattach restores bond membership recorded by older floodsd versions.
_fd_bond_reattach() {
    [ -f "$FLOODSD_BOND_STATE" ] || return 1
    local iface bond k v
    while IFS='=' read -r k v; do
        case "$k" in if) iface=$v ;; bond) bond=$v ;; esac
    done < "$FLOODSD_BOND_STATE"
    if [ -z "$iface" ] || [ -z "$bond" ]; then
        echo "floodsd restore: bond-state file is malformed; remove $FLOODSD_BOND_STATE and re-enslave manually."
        rm -f "$FLOODSD_BOND_STATE"
        return 1
    fi
    if ! ip link show "$bond" >/dev/null 2>&1; then
        echo "floodsd restore: bond '$bond' no longer exists — skipping re-enslave of '$iface'."
        rm -f "$FLOODSD_BOND_STATE"
        return 1
    fi

    echo "Re-adding $iface to bond $bond..."
    sudo ip link set "$iface" down
    echo "+$iface" | sudo tee "/sys/class/net/$bond/bonding/slaves" >/dev/null

    # Verify the sysfs write actually took rather than assuming it worked —
    # same reasoning as _fd_kernel_cleanup_all's post-write check.
    local nowmaster
    nowmaster=$(readlink "/sys/class/net/$iface/master" 2>/dev/null)
    rm -f "$FLOODSD_BOND_STATE"
    if [ -z "$nowmaster" ]; then
        echo "floodsd restore: WARNING — '$iface' doesn't show as enslaved to any bond after re-adding it to '$bond'."
        echo "  Check manually: ip link show $iface ; cat /sys/class/net/$bond/bonding/slaves"
        return 1
    fi
    if [ "${nowmaster##*/}" != "$bond" ]; then
        echo "floodsd restore: WARNING — '$iface' ended up enslaved to '${nowmaster##*/}', not '$bond' — check manually."
        return 1
    fi
    echo "Done — $iface is back in bond $bond."
}

# _fd_bond_pick_slave <bond> [current]: <bond> has no real per-queue
# hardware TX ring for a flood engine to drive directly, so this prompts for
# one of its slaves to actually flood from instead, printing the choice to
# stdout. Enter keeps [current] if given.
# _fd_bond_pick_slave <bond> [current]: prompt for which slave(s) of <bond> to
# flood from. Prints the chosen slave name, OR the literal token "ALL" if the
# user picks the all-slaves option (spread TX across every slave for max
# throughput — each slave is a separate physical NIC with its own TX rings, so
# driving both ~doubles the achievable pps against a multi-slave-bond target).
_fd_bond_pick_slave() {
    local bond=$1 cur=$2
    local slaves; slaves=$(cat "/sys/class/net/$bond/bonding/slaves" 2>/dev/null)
    if [ -z "$slaves" ]; then
        echo "floodsd: bond '$bond' has no slaves to flood from." >&2
        return 1
    fi
    local arr=($slaves) idx=1 s
    # Single slave: nothing to choose, and "all" would be identical — just use it.
    if [ "${#arr[@]}" -eq 1 ]; then
        echo "${arr[0]}"
        return 0
    fi
    echo "'$bond' is a bond — pick which of its slaves to actually flood from:" >&2
    for s in "${arr[@]}"; do
        printf "  %d) %s\n" "$idx" "$s" >&2
        idx=$((idx + 1))
    done
    printf "  a) ALL slaves (max throughput — spread TX cores across every slave)\n" >&2
    local sel
    read -rp "Slave${cur:+ (Enter = keep '$cur')} [1-${#arr[@]}/a]: " sel
    if [ -z "$sel" ]; then
        [ -z "$cur" ] && { echo "floodsd: no slave selected." >&2; return 1; }
        echo "$cur"
        return 0
    fi
    if [ "$sel" = a ] || [ "$sel" = A ] || [ "$sel" = all ]; then
        echo "ALL"
        return 0
    fi
    if ! [[ "$sel" =~ ^[0-9]+$ ]] || [ "$sel" -lt 1 ] || [ "$sel" -gt "${#arr[@]}" ]; then
        echo "floodsd: invalid selection '$sel'." >&2
        return 1
    fi
    echo "${arr[$((sel - 1))]}"
}

# ── floodsd ───────────────────────────────────────────

# _fd_udp_probe <iface> <destip> <destport> <srcport>: sends one UDP
# datagram bound to <srcport> and <iface> (SO_BINDTODEVICE, needs root) to
# <destip>:<destport>. Used in place of ICMP ping for the setup reachability
# check: this box's egress firewall keys off source port, which ICMP has no
# concept of, so ping is dropped outbound even though inbound ICMP works. A
# UDP datagram sourced from the flood's own port ($FLOOD_SPORT) gets through
# and is enough to trigger ARP resolution — no reply on <destport> is
# required or expected.
_fd_udp_probe() {
    local iface=$1 destip=$2 destport=$3 srcport=$4
    if ! command -v python3 >/dev/null 2>&1; then
        echo "floodsd: python3 not found (needed to send a UDP probe from a pinned source port) — install python3 and re-run." >&2
        return 1
    fi
    sudo python3 - "$iface" "$destip" "$destport" "$srcport" <<'PYEOF'
import socket, sys
iface, destip, destport, srcport = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    s.setsockopt(socket.SOL_SOCKET, 25, iface.encode())  # SO_BINDTODEVICE
except OSError:
    pass
try:
    s.bind(('0.0.0.0', srcport))
    s.sendto(b'floodsd-probe', (destip, destport))
except OSError as e:
    sys.exit(f"floodsd: UDP probe failed: {e}")
finally:
    s.close()
PYEOF
}

# _fd_nexthop_ip <iface> <destip>: prints the IP whose MAC actually needs
# resolving to reach <destip> out <iface> — <destip> itself if it's on-link
# (same subnet, no router), or the next-hop router's IP if <destip> is a
# routed hop away. This matters because the kernel only ever ARPs for
# whichever of those two is the real L2 neighbor: if there's a router in
# between, `ip neigh show <destip>` can never populate no matter how many
# probes you send — only the router's IP ever gets a neighbor entry. Packets
# still carry <destip> as their IP destination; only the resolved MAC (the
# L2 next hop) differs, exactly as normal routing works.
_fd_nexthop_ip() {
    local iface=$1 destip=$2
    ip route get "$destip" oif "$iface" 2>/dev/null | awk '{
        for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit }
        print $1; exit
    }'
}

# floodsd setup: pick the sending NIC, take a destination IP, resolve the
# real L2 next hop (see _fd_nexthop_ip — the target itself if on-link, or a
# router if routed), then send a UDP probe (see _fd_udp_probe) and read the
# resolved MAC out of the neighbor table. The probe doubles as a
# reachability check — if no ARP entry ever resolves, something's wrong with
# routing/cabling before you ever get to flooding.
_floodsd_setup() {
    _fd_parse_multiport "$@"
    local iface
    iface=$(_fd_pick_iface "floodsd" "Sending NIC" "$(_floodsd_get if)") || return 1

    if ! ip link show "$iface" >/dev/null 2>&1; then
        echo "floodsd setup: interface '$iface' not found."
        return 1
    fi

    # A bonded slave can send fine, but bonding's RX handler reassigns every
    # inbound skb it receives (including ARP/UDP replies) to the bond
    # master's netdevice — so a slave itself never sees them, and resolving
    # via the slave directly can never work. Resolve via the bond instead
    # when a slave is picked; $iface (the slave) is still what actually
    # floods later, once resolved.
    local probeif="$iface" bondmaster
    bondmaster=$(readlink "/sys/class/net/$iface/master" 2>/dev/null)
    if [ -n "$bondmaster" ]; then
        probeif=${bondmaster##*/}
        echo "'$iface' is a bonded slave — its inbound traffic (so ARP/probe replies too) lands on '$probeif', not '$iface'."
        echo "Resolving via '$probeif'; '$iface' is still what floods once resolved."
    fi

    if ! ip -4 -o addr show dev "$probeif" | grep -q .; then
        local cidr
        read -rp "$probeif has no IPv4 (needed to ping/ARP the target). Assign one (e.g. 10.0.0.2/24): " cidr
        [ -z "$cidr" ] && { echo "floodsd setup: no address given, aborting."; return 1; }
        sudo ip addr add "$cidr" dev "$probeif" || return 1
    fi

    local curdestip destip curdestmac
    curdestip=$(_floodsd_get destip)
    curdestmac=$(_floodsd_get destmac)
    read -rp "Destination IP (the validator under test)${curdestip:+ (Enter = keep '$curdestip')}: " destip
    destip=${destip:-$curdestip}
    [ -z "$destip" ] && { echo "floodsd setup: no destination IP given."; return 1; }

    local nexthop
    nexthop=$(_fd_nexthop_ip "$probeif" "$destip")
    if [ -z "$nexthop" ]; then
        echo "floodsd setup: no route to $destip out $probeif — check routing/cabling before flooding."
        return 1
    fi
    if [ "$nexthop" != "$destip" ]; then
        echo "$destip is routed via $nexthop (not on-link) — resolving $nexthop's MAC; packets stay addressed (IP) to $destip."
    fi

    # A prior failed attempt can leave a FAILED/INCOMPLETE neighbor entry
    # behind, which makes the kernel back off re-ARPing it for a while —
    # silently turning "retry" into a no-op. Flushing first keeps retries real.
    sudo ip neigh flush to "$nexthop" dev "$probeif" >/dev/null 2>&1

    echo "Probing $destip:$FLOOD_DPORT via $probeif (UDP, src port $FLOOD_SPORT) to resolve $nexthop's MAC..."
    if ! _fd_udp_probe "$probeif" "$destip" "$FLOOD_DPORT" "$FLOOD_SPORT"; then
        echo "floodsd setup: couldn't send a UDP probe to $destip:$FLOOD_DPORT from $probeif — check routing/cabling before flooding."
        return 1
    fi

    local destmac tries
    for tries in 1 2 3 4 5 6; do
        destmac=$(ip neigh show "$nexthop" dev "$probeif" 2>/dev/null | awk '/lladdr/{for(i=1;i<=NF;i++) if($i=="lladdr") print $(i+1)}' | head -1)
        [ -n "$destmac" ] && break
        sleep 0.5
        _fd_udp_probe "$probeif" "$destip" "$FLOOD_DPORT" "$FLOOD_SPORT" >/dev/null 2>&1
    done
    if [ -z "$destmac" ]; then
        echo "floodsd setup: probe(s) sent but no ARP entry resolved for $nexthop on $probeif — check routing/cabling before flooding."

        # Resolution can fail for reasons that have nothing to do with
        # whether the target's MAC actually changed (a transient hiccup, a
        # stale neighbor entry, momentary congestion) — if the destination
        # is unchanged from last time and we already have a MAC for it from
        # a prior successful setup, offer to just keep using that instead of
        # hard-failing.
        if [ -n "$curdestmac" ] && [ "$destip" = "$curdestip" ]; then
            local ans
            read -rp "Resolution failed, but a cached MAC for $destip from a previous setup exists ($curdestmac) — use it instead? [y/N]: " ans
            case "$ans" in
                y|Y|yes|Yes)
                    destmac=$curdestmac
                    echo "Using cached MAC $destmac for $destip."
                    ;;
                *)
                    return 1
                    ;;
            esac
        else
            return 1
        fi
    fi

    # Cycle-check the whole source-port rotation range. The flood rotates the
    # src port across FLOOD_SPORT..FLOOD_SPORT+FLOOD_SPORT_CNT-1 (to spread the
    # traffic across the target's RX queues / net tiles), so every one of those
    # ports must be egress-allowed by this box's firewall — a blocked port in
    # the range would silently swallow that fraction of the flood. Send one
    # probe from each port and flag any that can't be bound/sent from.
    # NOTE: a successful probe only confirms this box could bind + emit from the
    # port locally; it does not prove the far-side firewall accepts it (there's
    # no reply). It reliably catches local problems (port in use, local egress
    # reject, bind failure); confirm true egress with a tcpdump on the target.
    local spcnt; spcnt=$(_fd_sport_cnt)
    local p bad=""
    if [ "$spcnt" -gt 1 ]; then
        echo "Cycle-checking source ports $FLOOD_SPORT..$((FLOOD_SPORT + spcnt - 1)) (flood rotates across them)..."
        for ((p = FLOOD_SPORT; p < FLOOD_SPORT + spcnt; p++)); do
            if _fd_udp_probe "$probeif" "$destip" "$FLOOD_DPORT" "$p" >/dev/null 2>&1; then
                echo "  port $p: OK"
            else
                echo "  port $p: FAILED to send (in use, or blocked by a local egress rule?)"
                bad="$bad $p"
            fi
        done
        if [ -n "$bad" ]; then
            echo "floodsd setup: WARNING — could not emit from port(s):$bad — the flood will lose the fraction hashed to those ports."
            echo "  Ensure every port in $FLOOD_SPORT..$((FLOOD_SPORT + spcnt - 1)) is egress-allowed, or lower FLOOD_SPORT_CNT."
        fi
    fi

    _floodsd_set if "$iface"
    _floodsd_set destip "$destip"
    _floodsd_set destmac "$destmac"
    echo "Target saved: $destip via $nexthop ($destmac) -- flooding from $iface."
}

# floodsd setup-srcport: override the UDP source port the probe, kernel
# pktgen, and DPDK pktgen all egress from (default: 8424). Needed when this
# box's egress firewall pins outbound traffic to a source port other than
# the default — that port is whatever the box's owner/network team
# allowlisted, so ask them, or find it by testing: `sudo tcpdump -ni <iface>
# udp` while sending traffic from candidate ports shows whether packets
# actually leave the NIC. Persisted like the rest of the target state, so it
# survives across setup/dpdk/kernel invocations; re-run `floodsd setup`
# afterward to re-probe with the new port.
_floodsd_setup_srcport() {
    local cur port
    cur=$(_floodsd_get sport); cur=${cur:-$FLOOD_SPORT}
    read -rp "UDP source port to egress from (Enter = keep '$cur'): " port
    port=${port:-$cur}
    if ! [[ "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        echo "floodsd setup-srcport: invalid port '$port'."
        return 1
    fi
    _floodsd_set sport "$port"
    FLOOD_SPORT=$port
    echo "Source port set to $port. Re-run 'floodsd setup' to re-probe with the new port."
}

# _fd_ensure_pktgen_module: modprobe the in-kernel pktgen module, installing
# it first if missing. Debian/Ubuntu ship it in "linux-modules-extra-$(uname
# -r)", sometimes absent on minimal cloud images. RHEL-family is messier and
# has moved the package across releases: older RHEL/Rocky/Alma 9 shipped it
# in "kernel-modules-extra", but newer RHEL-9-derivative point releases
# (e.g. current Rocky Linux 9) moved pktgen and other net testing/debugging
# modules into "kernel-modules-internal" instead — so both are tried,
# internal first since that's where it lives on current RHEL-family
# releases. Package name is matched to the running kernel version so it
# isn't left on a mismatched/newer kernel package after an update.
_fd_ensure_pktgen_module() {
    sudo modprobe pktgen 2>/dev/null && return 0

    echo "floodsd kernel: 'pktgen' kernel module not found — installing for kernel $(uname -r)..."
    local krel; krel=$(uname -r)
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update -y
        sudo apt-get install -y "linux-modules-extra-${krel}" \
            || { echo "floodsd kernel: couldn't install linux-modules-extra-${krel} — install it manually."; return 1; }
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y "kernel-modules-internal-${krel}" 2>/dev/null \
            || sudo dnf install -y "kernel-modules-extra-${krel}" \
            || { echo "floodsd kernel: couldn't install kernel-modules-internal-${krel} or kernel-modules-extra-${krel} — install it manually."; return 1; }
    elif command -v yum >/dev/null 2>&1; then
        sudo yum install -y "kernel-modules-internal-${krel}" 2>/dev/null \
            || sudo yum install -y "kernel-modules-extra-${krel}" \
            || { echo "floodsd kernel: couldn't install kernel-modules-internal-${krel} or kernel-modules-extra-${krel} — install it manually."; return 1; }
    else
        echo "floodsd kernel: no supported package manager found (apt-get/dnf/yum) — install the pktgen kernel module manually."
        return 1
    fi

    sudo modprobe pktgen \
        || { echo "floodsd kernel: installed the package but 'modprobe pktgen' still fails — check 'uname -r' matches the installed module package."; return 1; }
}

# _fd_kernel_valid_rate <rate>: true if <rate> is "max" (any case) or a
# non-negative number.
_fd_kernel_valid_rate() {
    case "$1" in
        [Mm][Aa][Xx]) return 0 ;;
        *) [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ ]] ;;
    esac
}

# _fd_kernel_norm_rate <rate>: canonicalizes "max"/"Max"/etc to "MAX".
_fd_kernel_norm_rate() {
    case "$1" in
        [Mm][Aa][Xx]) echo MAX ;;
        *) echo "$1" ;;
    esac
}

# _fd_kernel_set_delay <rate> <ncores> <dev>...: computes the per-thread
# nanosecond delay for <rate> Mpps split evenly across <ncores> threads
# (MAX = 0 delay, i.e. no throttling) and writes it to each given device.
# Devices are passed explicitly (as "iface@N" names) so this works whether the
# flood runs on one interface or several bond slaves at once. Safe to call on a
# running flood or a stopped one — pktgen doesn't document live reconfiguration
# of an active device, so callers that want a rate change to apply mid-flood
# are expected to stop/restart around this (see 'start <rate>' in _floodsd_kernel).
_fd_kernel_set_delay() {
    local rate=$1 ncores=$2; shift 2
    local devs=("$@")
    local delay_ns dev
    if [ "$rate" = MAX ]; then
        delay_ns=0
    else
        delay_ns=$(awk -v mpps="$rate" -v cores="$ncores" 'BEGIN {
            total_pps = mpps * 1000000;
            pps_per_core = total_pps / cores;
            printf "%d", 1000000000 / pps_per_core
        }')
    fi
    for dev in "${devs[@]}"; do
        echo "delay $delay_ns" | sudo tee "/proc/net/pktgen/${dev}" >/dev/null
    done
}

# _fd_kernel_pkt_total <dev>...: sums "pkts-sofar" across all given devices
# (each an "iface@N" name) — used to compute the live Mpps counter. Works
# across multiple bond slaves since the device list is passed explicitly.
_fd_kernel_pkt_total() {
    local dev val total=0
    for dev in "$@"; do
        # sudo'd: pktgen's proc entries are commonly root-read-only (0600), so
        # an unprivileged read here just silently fails (2>/dev/null hides
        # it), permanently pinning the Mpps counter at 0 on boxes like that.
        val=$(sudo grep "pkts-sofar" "/proc/net/pktgen/${dev}" 2>/dev/null | awk '{print $2}')
        total=$((total + val))
    done
    echo "$total"
}

# _fd_kernel_thread_has_devices <core>: true if kpktgend_<core> still lists
# a device on its "Running:" or "Stopped:" line (pktgen's proc format —
# both list attached devices regardless of send state).
_fd_kernel_thread_has_devices() {
    local f="/proc/net/pktgen/kpktgend_${1}"
    [ -e "$f" ] || return 1
    # sudo'd: these proc entries are commonly root-read-only (0600). Without
    # it, an unprivileged read fails outright ("awk: fatal: cannot open ...
    # Permission denied") instead of just returning false — and since this
    # runs once per core per cleanup attempt, that's the exact failure that
    # spams dozens of near-identical errors on a box with many cores.
    sudo awk -F': ' '/^Running:|^Stopped:/ { if (length($2) > 0) found=1 } END { exit !found }' "$f"
}

# _fd_kernel_cleanup_all: stop sending and rem_device_all across *every*
# kpktgend_N thread (0..nproc-1) — not just whatever core range the current
# session picked. This is the fix for a real bug: pgctrl start/stop is
# global to the whole pktgen subsystem, but device (re)configuration used to
# only touch the top-N cores requested *this* run. Shrinking the core count
# between 'floodsd kernel' sessions (or re-pointing at a new target via
# 'floodsd setup' in between) left lower-numbered cores' devices attached
# with their old dst/delay — and 'start' would fire them too, silently
# flooding a stale target alongside the intended one. Verifies the sweep
# actually took (retrying once) rather than assuming rem_device_all worked;
# returns 1 (with a warning already printed) if devices are still stuck.
_fd_kernel_cleanup_all() {
    echo "stop" | sudo tee /proc/net/pktgen/pgctrl >/dev/null 2>&1

    # Sweep the pktgen threads that ACTUALLY EXIST (glob the proc dir), NOT a
    # 0..nproc-1 range. pktgen creates one kpktgend_N per CPU present when the
    # module loaded and they persist for the module's lifetime -- but nproc
    # reflects only currently-*online* CPUs. If cores were offlined (or this
    # process runs under a reduced affinity mask) after a flood was set up,
    # nproc shrinks while the high-numbered threads (and their attached
    # devices) live on. An nproc-bounded loop then skips exactly those threads
    # AND its verification skips them too -- so it reports "all detached" while
    # stale devices survive up top. Since pktgen device names (iface@N) are
    # GLOBAL across threads, those survivors then EBUSY every new add_device.
    # Globbing the real thread files covers every thread regardless of the
    # current online-CPU count.
    local f n attempt leftover
    for attempt in 1 2; do
        for f in /proc/net/pktgen/kpktgend_*; do
            [ -e "$f" ] || continue
            echo "rem_device_all" | sudo tee "$f" >/dev/null 2>&1
        done
        leftover=0
        for f in /proc/net/pktgen/kpktgend_*; do
            [ -e "$f" ] || continue
            n=${f##*/kpktgend_}
            _fd_kernel_thread_has_devices "$n" && leftover=$((leftover + 1))
        done
        [ "$leftover" -eq 0 ] && return 0
        [ "$attempt" -eq 1 ] && echo "floodsd kernel: $leftover thread(s) still show attached devices after cleanup — retrying..."
    done

    echo "floodsd kernel: WARNING — $leftover pktgen thread(s) still have devices attached after two cleanup attempts."
    echo "  Check manually: sudo grep -l 'Stopped: \\|Running: ' /proc/net/pktgen/kpktgend_* 2>/dev/null | xargs -r sudo grep -H 'Stopped:\\|Running:'"
    return 1
}

# _fd_kernel_write <file> <cmd>: writes one pktgen command, checking the
# result instead of firing-and-forgetting it. pktgen proc writes fail in
# more ways than you'd expect (permission issues, or kernel-internal error
# codes like ENOTSUPP=524 leaking through untranslated as "tee: ... Unknown
# error 524" — classically from queue_map_min/max exceeding what the
# NIC/bond actually supports) — and without a check, one bad write silently
# cascades through the rest of that device's commands, then repeats
# identically for every remaining core. Names the exact command and file
# that failed instead.
_fd_kernel_write() {
    local file=$1 cmd=$2
    if ! echo "$cmd" | sudo tee "$file" >/dev/null; then
        echo "floodsd kernel: '$cmd' -> $file failed." >&2
        return 1
    fi
}

# floodsd kernel: in-kernel pktgen flood, driven by an interactive prompt
# (loosely mirroring pktgen-dpdk's own interactive CLI). pktgen's kernel
# threads (kpktgend_N) are pinned 1:1 to CPU N, so "core selection" here just
# means which kpktgend_N thread a device gets loaded into — cores are picked
# top-down (highest first) to match pktfd's convention and avoid low cores
# other tools tend to pin to. Core count is fixed for the session (asked
# once, up front); quit and re-run to change it. Commands at the prompt:
#   start            start (or, if already running, no-op) at the current rate
#   start <mpps|max> set the rate and (re)start — if already running, this
#                    stops, rewrites the per-thread delay, and restarts
#                    (a brief sub-second gap; pktgen doesn't document live
#                    reconfiguration of an actively-sending device)
#   stop             halt sending; devices stay configured, 'start' resumes
#   quit / exit      full cleanup (stop + rem_device_all everywhere,
#                    verified — see _fd_kernel_cleanup_all), then leave
# Ctrl-C and EOF (Ctrl-D) both behave like 'quit' rather than leaving an
# orphaned flood with no controlling shell. There's deliberately no
# 'floodsd restore' equivalent for the kernel engine — quit's own cleanup
# is what's supposed to guarantee nothing is left running/attached.
_floodsd_kernel() {
    _fd_parse_multiport "$@"
    _fd_parse_dport "$@"
    local iface destip destmac
    iface=$(_floodsd_get if); destip=$(_floodsd_get destip); destmac=$(_floodsd_get destmac)
    if [ -z "$iface" ] || [ -z "$destip" ] || [ -z "$destmac" ]; then
        echo "floodsd kernel: no target configured — run 'floodsd setup' first."
        return 1
    fi

    # Source IP for the flood. pktgen sets NO source address by default, so
    # packets egress with src 0.0.0.0 -- a martian that routers drop (uRPF /
    # RFC 1812 bogon filtering), so an off-subnet flood silently never arrives
    # even though pktgen reports 0 errors. The DPDK path already pins src ip;
    # mirror it here. Prefer the source the kernel would pick for the target
    # (correct even on a bond, where the IP lives on the master, not the
    # slaves we inject from), falling back to the iface's own IPv4.
    local srcip
    srcip=$(ip -4 route get "$destip" 2>/dev/null | sed -n 's/.*src \([0-9.]*\).*/\1/p' | head -1)
    if [ -z "$srcip" ]; then
        srcip=$(ip -4 -o addr show "$iface" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
    fi
    if [ -z "$srcip" ]; then
        echo "floodsd kernel: couldn't determine a source IPv4 address for '$iface'. Assign an IPv4 address and retry."
        return 1
    fi
    echo "Source IP: $srcip"
    if ! ip link show "$iface" >/dev/null 2>&1; then
        echo "floodsd kernel: interface '$iface' not found (was it rebound to vfio-pci? check 'floodsd restore')."
        return 1
    fi

    # ifaces[] is the list of physical interfaces pktgen will actually drive.
    # For a plain NIC that's just itself; for a bond it's one chosen slave, or
    # every slave when the user picks "all" (each slave is a separate physical
    # NIC with its own TX rings, so driving them all ~multiplies throughput).
    local ifaces=("$iface")
    if [ -d "/sys/class/net/$iface/bonding" ]; then
        # pktgen injects packets directly into a real per-queue hardware TX
        # ring; a bond is a purely software netdevice with no such thing, and
        # driving it directly tends to surface as skb/protocol errors rather
        # than a clean failure — so flood from its slave(s) instead.
        local bondiface="$iface" slave
        slave=$(_fd_bond_pick_slave "$bondiface" "$(_floodsd_get kernslave)") || return 1
        _floodsd_set kernslave "$slave"
        if [ "$slave" = ALL ]; then
            ifaces=($(cat "/sys/class/net/$bondiface/bonding/slaves" 2>/dev/null))
            echo "Flooding via ALL slaves of '$bondiface': ${ifaces[*]} — '$bondiface' itself has no real hardware TX ring for pktgen to drive."
        else
            ifaces=("$slave")
            echo "Flooding via '$slave' — '$bondiface' itself has no real hardware TX ring for pktgen to drive."
        fi
    fi
    local niface=${#ifaces[@]}

    local curcores ncores
    curcores=$(_floodsd_get kerncores); curcores=${curcores:-4}
    read -rp "TX cores/threads? [${curcores}] " ncores
    ncores=${ncores:-$curcores}
    if ! [[ "$ncores" =~ ^[0-9]+$ ]] || [ "$ncores" -lt 1 ]; then
        echo "floodsd kernel: invalid core count '$ncores'."
        return 1
    fi
    _floodsd_set kerncores "$ncores"

    local hi=$(( $(nproc) - 1 )) lo
    lo=$((hi - ncores + 1))
    if [ "$lo" -lt 0 ]; then
        echo "floodsd kernel: $ncores cores would run past core 0 (highest core = $hi). Choose fewer."
        return 1
    fi

    local rate; rate=$(_floodsd_get kernrate); rate=${rate:-MAX}

    _fd_ensure_pktgen_module || return 1
    # Clean slate across ALL threads, not just the ones this session picked —
    # otherwise a previous run with a larger core count (or a different
    # target) can leave stale devices attached that 'start' would fire too.
    _fd_kernel_cleanup_all

    # Source-port range: [sport_lo, sport_hi). In --multiport mode this spans
    # FLOOD_SPORT .. FLOOD_SPORT+FLOOD_SPORT_CNT-1; by default it's the single
    # port FLOOD_SPORT (hi = lo+1). pktgen picks a random src port in
    # [udp_src_min, udp_src_max) each time it (re)builds a packet (every
    # clone_skb copy) when UDPSRC_RND is set — with a 1-wide range that's just
    # the one port, pinning the flood to a single RX queue / net tile.
    local spcnt; spcnt=$(_fd_sport_cnt)
    local sport_lo=$FLOOD_SPORT sport_hi=$((FLOOD_SPORT + spcnt))
    if [ "$FLOOD_MULTIPORT" = 1 ]; then
        echo "Source-port rotation: ON (--multiport) — sweeping $sport_lo..$((sport_hi - 1)) across the target's RX queues / net tiles."
    else
        echo "Source-port rotation: OFF (default) — single source port $sport_lo (one RX queue / net tile). Pass --multiport to spread across queues."
    fi

    # Assign each TX core to a device. With multiple interfaces (all-slaves),
    # cores are dealt out round-robin across them, and each interface's queue
    # index counts up independently (so iface A gets its queues 0,1,2.. and
    # iface B its queues 0,1,2.., rather than a shared 0..ncores that could run
    # off the end of one NIC's queue count). devs[] records every device name
    # so the rate/delay/cleanup helpers can act on all of them.
    local i core dev thread cmd ifidx qidx srcmac
    local -a devs=()
    local -a ifq   # per-interface queue counter
    for ((i = 0; i < niface; i++)); do ifq[$i]=0; done
    for ((i = 0; i < ncores; i++)); do
        core=$((hi - i))
        thread="kpktgend_${core}"
        ifidx=$((i % niface))
        iface="${ifaces[$ifidx]}"
        qidx=${ifq[$ifidx]}
        # Pin src MAC to this flooding interface's own MAC (an 802.3ad slave
        # already carries the bond master's MAC, so this is what the switch
        # expects); pktgen would otherwise use whatever the device defaults to.
        srcmac=$(cat "/sys/class/net/$iface/address" 2>/dev/null)
        ifq[$ifidx]=$((qidx + 1))
        # Device name suffix is the per-interface queue index (matches
        # queue_map below). Unique per interface, and each slave's queues start
        # at 0 so we never index past a NIC's real TX-queue count.
        dev="${iface}@${qidx}"
        devs+=("$dev")

        if ! _fd_kernel_write "/proc/net/pktgen/$thread" "add_device $dev"; then
            echo "  If this is 'Device or resource busy', a previous kernel flood is still attached to the pktgen threads (e.g. a lost SSH session): run 'floodsd stop' to tear it down, then retry 'floodsd kernel'."
            echo "  If this is 'Permission denied' despite running as root, it's very likely SELinux (common on hardened RHEL-family boxes):"
            echo "    getenforce                                 # check if it's Enforcing"
            echo "    sudo ausearch -m avc -ts recent | grep -i pktgen   # see the actual denial"
            echo "  A permissive test: 'sudo setenforce 0' (temporary, reverts on reboot) — or get a policy module allowing this from whoever owns the box."
            return 1
        fi

        for cmd in "count 0" "clone_skb 1000" "pkt_size 64" \
                   "queue_map_min $qidx" "queue_map_max $qidx" \
                   "dst $destip" "dst_mac $destmac" \
                   "src_min $srcip" "src_max $srcip" \
                   ${srcmac:+"src_mac $srcmac"} \
                   "flag UDPSRC_RND" \
                   "udp_src_min $sport_lo" "udp_src_max $sport_hi" \
                   "udp_dst_min $FLOOD_DPORT" "udp_dst_max $FLOOD_DPORT"; do
            if ! _fd_kernel_write "/proc/net/pktgen/$dev" "$cmd"; then
                case "$cmd" in
                    queue_map_*)
                        echo "  '$cmd' failing often means $iface (or its bond) doesn't have that many TX queues."
                        echo "  Check: ethtool -l $iface   (or: ls /sys/class/net/$iface/queues/tx-* | wc -l)"
                        echo "  and try fewer TX cores/threads than it reports."
                        ;;
                esac
                return 1
            fi
        done
    done
    _fd_kernel_set_delay "$rate" "$ncores" "${devs[@]}"

    if [ "$niface" -gt 1 ]; then
        echo "Configured $ncores TX cores (cores $lo-$hi) across ${niface} slaves (${ifaces[*]}) -> $destip:$FLOOD_DPORT ($destmac)."
    else
        echo "Configured $ncores TX cores (cores $lo-$hi) -> $destip:$FLOOD_DPORT ($destmac) via ${ifaces[0]}."
    fi
    echo "Commands: start | start <mpps|max> | stop | rate | quit"

    local running=0 p1=0 p2 diff mpps line rc last_t=0 now prompt_shown=0
    trap 'echo; _fd_kernel_cleanup_all && echo "Stopped — all pktgen devices cleared."; echo "Exiting."; trap - INT; return 0' INT

    # Polls every 10s (not `read -p`, which reprints its prompt on every
    # call — including every timeout tick — with no leading newline; that
    # piled up duplicate prompts on one physical line when idle, and while
    # running glued the periodic status onto whatever you were mid-typing).
    # Printing the prompt ourselves, only once until a submitted line or a
    # status update invalidates it, keeps each on its own line. A 1-second
    # tick made this collide with in-progress typing often enough to be
    # annoying; at 10s it's rare enough to live with in exchange for the
    # live ticker. 'rate' still gives you a check in between ticks.
    while true; do
        local prompt="floodsd kernel"
        [ "$running" = 1 ] && prompt="floodsd kernel [running, ${rate} Mpps]"

        if [ "$prompt_shown" = 0 ]; then
            printf '%s> ' "$prompt"
            prompt_shown=1
        fi

        if IFS= read -r -t 10 line; then
            prompt_shown=0
            case "$line" in
                start)
                    if [ "$running" = 1 ]; then
                        echo "Already running at ${rate} Mpps."
                    else
                        # This write blocks until 'stop' is written elsewhere (pktgen's own
                        # semantics), so it has to run in the background — but the script
                        # isn't under interactive job control, so a backgrounded job shares
                        # the foreground process group and Ctrl-C's SIGINT hits it directly.
                        # Some sudo builds handle a raw SIGINT mid-flight badly enough to trip
                        # glibc's fortify stack-protector ("longjmp causes uninitialized stack
                        # frame"). The INT trap below already shuts this down gracefully (by
                        # writing 'stop', which unblocks it cleanly) — ignoring INT here just
                        # stops the terminal's raw signal from also hitting it first.
                        ( trap '' INT; echo "start" | sudo tee /proc/net/pktgen/pgctrl >/dev/null ) &
                        running=1
                        p1=$(_fd_kernel_pkt_total "${devs[@]}")
                        last_t=$(date +%s.%N)
                        echo "Started at ${rate} Mpps."
                    fi
                    ;;
                start\ *)
                    local newrate; newrate=$(echo "${line#start }" | xargs)
                    if ! _fd_kernel_valid_rate "$newrate"; then
                        echo "Invalid rate '$newrate' — use a number or MAX."
                    else
                        rate=$(_fd_kernel_norm_rate "$newrate")
                        _floodsd_set kernrate "$rate"
                        if [ "$running" = 1 ]; then
                            echo "stop" | sudo tee /proc/net/pktgen/pgctrl >/dev/null 2>&1
                        fi
                        _fd_kernel_set_delay "$rate" "$ncores" "${devs[@]}"
                        # Backgrounded + INT-ignoring for the same reason as the 'start' case above.
                        ( trap '' INT; echo "start" | sudo tee /proc/net/pktgen/pgctrl >/dev/null ) &
                        running=1
                        p1=$(_fd_kernel_pkt_total "${devs[@]}")
                        last_t=$(date +%s.%N)
                        echo "Rate set to ${rate} Mpps."
                    fi
                    ;;
                stop)
                    if [ "$running" = 1 ]; then
                        echo "stop" | sudo tee /proc/net/pktgen/pgctrl >/dev/null 2>&1
                        running=0
                        echo "Stopped (devices stay configured — 'start' resumes)."
                    else
                        echo "Already stopped."
                    fi
                    ;;
                rate)
                    if [ "$running" = 1 ]; then
                        p2=$(_fd_kernel_pkt_total "${devs[@]}")
                        now=$(date +%s.%N)
                        diff=$((p2 - p1))
                        mpps=$(awk -v diff="$diff" -v t0="$last_t" -v t1="$now" 'BEGIN {
                            dt = t1 - t0; if (dt <= 0) dt = 1
                            printf "%.2f", (diff / 1000000) / dt
                        }')
                        echo "  ~$mpps Mpps (since last check)"
                        p1=$p2; last_t=$now
                    else
                        echo "Not running."
                    fi
                    ;;
                quit | exit)
                    _fd_kernel_cleanup_all && echo "Stopped — all pktgen devices cleared."
                    trap - INT
                    return 0
                    ;;
                "") ;;
                *)
                    echo "Unknown command '$line'. Use: start | start <mpps|max> | stop | rate | quit"
                    ;;
            esac
        else
            rc=$?
            if [ "$rc" -gt 128 ]; then
                if [ "$running" = 1 ]; then
                    p2=$(_fd_kernel_pkt_total "${devs[@]}")
                    now=$(date +%s.%N)
                    diff=$((p2 - p1))
                    mpps=$(awk -v diff="$diff" -v t0="$last_t" -v t1="$now" 'BEGIN {
                        dt = t1 - t0; if (dt <= 0) dt = 1
                        printf "%.2f", (diff / 1000000) / dt
                    }')
                    echo
                    echo "  [$mpps Mpps]"
                    p1=$p2; last_t=$now
                    prompt_shown=0
                fi
            else
                # EOF (Ctrl-D / stdin closed) — same as quit.
                _fd_kernel_cleanup_all && echo "Stopped — all pktgen devices cleared."
                trap - INT
                return 0
            fi
        fi
    done
}

# floodsd stop: full kill switch for the in-kernel pktgen flood from a
# separate shell — stops sending AND detaches every device. Independent of
# the interactive prompt above: kernel pktgen state outlives the shell that
# configured it, so if that session dies (SSH drop, closed terminal) while a
# flood is running, its devices stay bound to the pktgen threads and the next
# ‘floodsd kernel’ fails with ‘Device or resource busy’ — this clears that.
_floodsd_stop() {
    # Full teardown, not just pgctrl: stop sending AND rem_device_all across
    # every kpktgend_N thread (verified), exactly like the interactive prompt's
    # 'quit'. A lost kernel session (SSH drop / closed terminal) leaves its
    # devices bound to the pktgen threads; a plain 'stop' would leave them there
    # and the next 'floodsd kernel' fails with 'add_device ... Device or resource
    # busy'. Tearing everything down here means 'floodsd kernel' starts clean.
    if _fd_kernel_cleanup_all; then
        echo "Kernel pktgen stopped and all devices detached."
    else
        echo "Kernel pktgen stopped, but some devices could not be detached (see warning above)." >&2
        return 1
    fi
}

PKTGEN_SRC_DIR="$HOME/.local/src/pktgen-dpdk"
PKTGEN_PREFIX="$HOME/.local"
PKTGEN_BIN="$PKTGEN_PREFIX/bin/pktgen"
FLOODSD_DPDK_PREFIX="$HOME/.local/share/floodsd/dpdk-25.11"

_floodsd_dpdk_pkg_config() {
    if [ -f "$FLOODSD_DPDK_PREFIX/floodsd-built" ]; then
        PKG_CONFIG_PATH="$FLOODSD_DPDK_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" pkg-config "$@"
    else
        pkg-config "$@"
    fi
}

_floodsd_build_dpdk() {
    local source="$HOME/.local/src/floodsd-dpdk-25.11" build head changes
    local commit=ed957165eadbe60a47d5ec223578cdd1c13d0bd9
    mkdir -p "$(dirname "$source")" "$HOME/.cache/floodsd" || return 1
    if [ ! -d "$source/.git" ]; then
        git clone --depth 1 --branch v25.11 https://github.com/DPDK/dpdk.git "$source" || return 1
    fi
    head=$(git -C "$source" rev-parse HEAD) || return 1
    changes=$(git -C "$source" status --porcelain) || return 1
    if [ "$head" != "$commit" ] || [ -n "$changes" ]; then
        echo "floodsd dpdk: local DPDK source differs from the audited release." >&2
        return 1
    fi
    build=$(mktemp -d "$HOME/.cache/floodsd/dpdk-build.XXXXXX") || return 1
    echo "Building DPDK 25.11 under $FLOODSD_DPDK_PREFIX..."
    meson setup "$build" "$source" --prefix="$FLOODSD_DPDK_PREFIX" --libdir=lib \
        -Ddefault_library=shared -Ddeveloper_mode=disabled -Dtests=false -Ddisable_apps='*' \
        -Denable_drivers=bus/pci,bus/vdev,bus/auxiliary,common/mlx5,mempool/ring,net/mlx5,net/ice,net/i40e,net/ixgbe \
        || return 1
    if ! grep -q '^#define HAVE_IBV_FLOW_DV_SUPPORT 1$' "$build/drivers/common/mlx5/mlx5_autoconf.h" || \
       ! grep -q '^#define RTE_NET_MLX5 1$' "$build/rte_build_config.h"; then
        echo "floodsd dpdk: this DPDK build lacks the required mlx5 support." >&2
        return 1
    fi
    ninja -C "$build" -j 2 && ninja -C "$build" install || return 1
    printf '%s\n' "$commit" > "$FLOODSD_DPDK_PREFIX/floodsd-built" || return 1
}

# _floodsd_patch_pktgen isolates mlx5 reception before configuring any port.
_floodsd_patch_pktgen() {
    python3 - <<'PYEOF'
from pathlib import Path

path = Path('app/pktgen-port-cfg.c')
source = path.read_text()
if 'floodsd_prepare_ports' in source:
    raise SystemExit('floodsd dpdk: Pktgen source already has a local startup patch.')
def replace(old, new):
    global source
    if source.count(old) != 1:
        raise SystemExit('floodsd dpdk: unsupported Pktgen source, refusing an unsafe build.')
    source = source.replace(old, new)

replace('#include <rte_dev.h>', '#include <rte_dev.h>\n#include <rte_flow.h>')
replace('static void\n_mtu_defaults(', r'''static int
floodsd_is_mlx5(const char *driver)
{
    return driver && (!strcmp(driver, "mlx5_pci") || !strcmp(driver, "net_mlx5"));
}

static void
_mtu_defaults(''')
replace('void\npktgen_config_ports(void)', r'''static void
floodsd_prepare_ports(void)
{
    const char *requested = getenv("FLOODSD_DPDK_PCI");
    const char *require_mlx5 = getenv("FLOODSD_DPDK_MLX5");
    char *devices, *next, *expected;
    uint16_t pid;

    if (!requested || !*requested)
        rte_exit(EXIT_FAILURE, "Launch this protected Pktgen through floodsd.\n");
    devices = strdup(requested);
    if (!devices)
        rte_exit(EXIT_FAILURE, "Cannot allocate requested device list.\n");
    expected = strtok_r(devices, ",", &next);
    RTE_ETH_FOREACH_DEV(pid) {
        struct rte_eth_dev_info info;
        struct rte_flow_error error = {0};

        if (rte_eth_dev_info_get(pid, &info) || !info.device ||
            !expected || strcmp(rte_dev_name(info.device), expected))
            rte_exit(EXIT_FAILURE, "Probed ports differ from requested PCI devices.\n");
        if (require_mlx5 && !strcmp(require_mlx5, "1") && !floodsd_is_mlx5(info.driver_name))
            rte_exit(EXIT_FAILURE, "Requested mlx5 device has an unexpected DPDK driver.\n");
        if (floodsd_is_mlx5(info.driver_name)) {
            if (rte_flow_isolate(pid, 1, &error))
                rte_exit(EXIT_FAILURE, "Cannot isolate mlx5 RX on port %u, %s.\n",
                         pid, error.message ? error.message : "unsupported");
            pktgen_log_info("floodsd mlx5 receive isolation v3, port %u", pid);
        }
        expected = strtok_r(NULL, ",", &next);
    }
    if (expected)
        rte_exit(EXIT_FAILURE, "Not all requested PCI devices were probed.\n");
    free(devices);
}

void
pktgen_config_ports(void)''')
replace('    /* Setup the number of ports to display at a time */',
        '    floodsd_prepare_ports();\n\n    /* Setup the number of ports to display at a time */')
replace('    conf->rxmode.mtu = pinfo->max_mtu;', r'''    if (floodsd_is_mlx5(dinfo->driver_name)) {
        uint16_t mtu;
        if (rte_eth_dev_get_mtu(pinfo->pid, &mtu))
            rte_exit(EXIT_FAILURE, "Cannot read mlx5 host MTU.\n");
        pinfo->max_mtu = mtu;
    }
    conf->rxmode.mtu = pinfo->max_mtu;''')
replace('    if (max_mtu < dinfo->min_mtu) {',
        '    if (floodsd_is_mlx5(pinfo->dev_info.driver_name))\n'
        '        return;\n\n'
        '    if (max_mtu < dinfo->min_mtu) {')
path.write_text(source)
PYEOF
}

# _floodsd_ensure_dpdk builds protected Pktgen against DPDK 25.11.
_floodsd_ensure_dpdk() {
    local dpdk_version
    dpdk_version=$(_floodsd_dpdk_pkg_config --modversion libdpdk 2>/dev/null) || dpdk_version=""
    case "$dpdk_version" in
        25.11|25.11.*)
            if [ -x "$PKTGEN_BIN" ] && grep -aqF 'floodsd mlx5 receive isolation v3' "$PKTGEN_BIN"; then
                return 0
            fi
            ;;
    esac

    echo "floodsd dpdk: building Pktgen with mlx5 receive isolation."
    echo "  This installs DPDK's dev packages via the system package manager (the"
    echo "  system-wide step), then builds Pktgen under $PKTGEN_PREFIX."
    echo "  If packaged DPDK is unsuitable, DPDK 25.11 is built under $FLOODSD_DPDK_PREFIX."
    local ans
    read -rp "Proceed? [y/N] " ans
    case "$ans" in
        y|Y|yes|Yes) ;;
        *) echo "Aborted — install pktgen manually, or re-run to retry."; return 1 ;;
    esac

    local pkgmgr
    if command -v apt-get >/dev/null 2>&1; then
        pkgmgr=apt
    elif command -v dnf >/dev/null 2>&1; then
        pkgmgr=dnf
    elif command -v yum >/dev/null 2>&1; then
        pkgmgr=yum
    else
        echo "floodsd dpdk: no supported package manager found (apt-get/dnf/yum) — install DPDK + Pktgen-DPDK manually."
        return 1
    fi

    echo "Installing DPDK + build dependencies ($pkgmgr)..."
    case "$pkgmgr" in
        apt)
            sudo apt-get update -y || return 1
            sudo apt-get install -y dpdk dpdk-dev meson ninja-build pkg-config libnuma-dev libpcap-dev libbsd-dev \
                libibverbs-dev librdmacm-dev libelf-dev python3-pyelftools git gcc make \
                || { echo "floodsd dpdk: package install failed — install DPDK manually and re-run."; return 1; }
            ;;
        dnf|yum)
            # Minimal RHEL-family images (Rocky/Alma/RHEL 9) often lack a C
            # toolchain entirely — gcc/make aren't pulled in by dpdk-devel.
            local dpdk_pkgs=(dpdk dpdk-devel meson ninja-build pkgconf-pkg-config numactl-devel libpcap-devel libbsd-devel rdma-core-devel elfutils-libelf-devel python3-pyelftools git gcc make)
            if ! sudo "$pkgmgr" install -y "${dpdk_pkgs[@]}" 2>/dev/null; then
                # dpdk-devel is sometimes unresolvable on a minimal RHEL-family 9
                # install until EPEL + CRB (CodeReady Builder, formerly
                # PowerTools) are enabled. Try enabling both, then retry once
                # before giving up.
                echo "floodsd dpdk: initial install failed — trying with EPEL + CRB enabled (common on minimal RHEL-family images)..."
                sudo "$pkgmgr" install -y epel-release dnf-plugins-core 2>/dev/null
                sudo dnf config-manager --set-enabled crb 2>/dev/null \
                    || sudo dnf config-manager --set-enabled powertools 2>/dev/null
                sudo "$pkgmgr" install -y "${dpdk_pkgs[@]}" \
                    || { echo "floodsd dpdk: package install failed even with EPEL/CRB enabled — install DPDK manually and re-run."; return 1; }
            fi
            ;;
    esac

    dpdk_version=$(_floodsd_dpdk_pkg_config --modversion libdpdk 2>/dev/null) || dpdk_version=""
    case "$dpdk_version" in
        25.11|25.11.*) ;;
        *) _floodsd_build_dpdk || return 1 ;;
    esac

    mkdir -p "$(dirname "$PKTGEN_SRC_DIR")"
    if [ -d "$PKTGEN_SRC_DIR/.git" ]; then
        echo "Updating existing Pktgen-DPDK checkout..."
        git -C "$PKTGEN_SRC_DIR" pull || return 1
    else
        echo "Cloning Pktgen-DPDK..."
        git clone https://github.com/pktgen/Pktgen-DPDK.git "$PKTGEN_SRC_DIR" || return 1
    fi

    echo "Building Pktgen-DPDK (meson + ninja), installing to $PKTGEN_PREFIX..."
    (
        cd "$PKTGEN_SRC_DIR" || exit 1
        local dpdk_libdir
        dpdk_libdir=$(_floodsd_dpdk_pkg_config --variable=libdir libdpdk) || exit 1
        if [ -f "$FLOODSD_DPDK_PREFIX/floodsd-built" ]; then
            export PKG_CONFIG_PATH="$FLOODSD_DPDK_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
        fi
        export LD_LIBRARY_PATH="$dpdk_libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        local backup
        backup=$(mktemp -d "$(dirname "$PKTGEN_SRC_DIR")/pktgen-build.XXXXXX") || exit 1
        cp -p app/pktgen-port-cfg.c "$backup/port.c" && cp -p lib/common/cksum.c "$backup/cksum.c" || exit 1
        trap 'cp -p "$backup/port.c" app/pktgen-port-cfg.c && cp -p "$backup/cksum.c" lib/common/cksum.c && rm -rf "$backup" || exit 1' EXIT
        _floodsd_patch_pktgen || exit 1
        sed -i '/^#include <rte_lpm\.h>$/d' lib/common/cksum.c || exit 1
        rm -rf build
        meson setup build --prefix="$PKTGEN_PREFIX" --libdir=lib "-Dc_link_args=-Wl,-rpath,$dpdk_libdir" || exit 1
        ninja -C build || exit 1
        ninja -C build install || exit 1
    ) || { echo "floodsd dpdk: build failed — see output above."; return 1; }

    if [ ! -x "$PKTGEN_BIN" ] || ! grep -aqF 'floodsd mlx5 receive isolation v3' "$PKTGEN_BIN"; then
        echo "floodsd dpdk: protected Pktgen binary was not produced."
        return 1
    fi
    echo "pktgen installed: $PKTGEN_BIN"
}

# _fd_dpdk_device checks the interface and PCI address before privileged setup.
_fd_dpdk_device() {
    local iface=$1 device driver node
    if [ ! -d "/sys/class/net/$iface" ]; then
        echo "floodsd dpdk: interface '$iface' does not exist." >&2
        return 1
    fi
    device=$(readlink -f "/sys/class/net/$iface/device") || return 1
    device=${device##*/}
    driver=$(readlink -f "/sys/class/net/$iface/device/driver") || return 1
    driver=${driver##*/}
    if ! [[ "$device" =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]$ ]] ||
       [ ! -d "/sys/bus/pci/devices/$device" ] || [ ! -L "/sys/class/net/$iface/device/driver" ]; then
        echo "floodsd dpdk: '$iface' has no bound PCI device." >&2
        return 1
    fi
    node=$(cat "/sys/class/net/$iface/device/numa_node") || return 1
    printf '%s %s %s\n' "$device" "$driver" "$node"
}

# _floodsd_dpdk keeps mlx5 reception with Linux and launches Pktgen for TX.
_floodsd_dpdk() {
    _fd_parse_dport "$@"
    _fd_parse_multiport "$@"
    local iface destip destmac sourceif ifip master
    iface=$(_floodsd_get if); destip=$(_floodsd_get destip); destmac=$(_floodsd_get destmac)
    if [ -z "$iface" ] || [ -z "$destip" ] || [ -z "$destmac" ]; then
        echo "floodsd dpdk: no target configured — run 'floodsd setup' first."
        return 1
    fi

    if [ ! -d "/sys/class/net/$iface" ]; then
        echo "floodsd dpdk: interface '$iface' does not exist. Check 'floodsd restore'." >&2
        return 1
    fi
    if [ -e "$FLOODSD_VFIO_STATE" ] || [ -e "$FLOODSD_BOND_STATE" ]; then
        echo "floodsd dpdk: previous driver or bond changes need 'floodsd restore' first." >&2
        return 1
    fi

    sourceif=$iface
    master=$(readlink "/sys/class/net/$iface/master" 2>/dev/null) || master=""
    [ -n "$master" ] && sourceif=${master##*/}
    local members=("$iface") slave selection=""
    if [ -d "/sys/class/net/$iface/bonding" ]; then
        slave=$(_fd_bond_pick_slave "$iface" "$(_floodsd_get dpdkslave)") || return 1
        selection=$slave
        if [ "$slave" = ALL ]; then
            read -r -a members < "/sys/class/net/$iface/bonding/slaves" || return 1
        else
            members=("$slave")
        fi
        [ "${#members[@]}" -gt 0 ] || return 1
        for slave in "${members[@]}"; do
            master=$(readlink "/sys/class/net/$slave/master") || return 1
            if [ "${master##*/}" != "$iface" ]; then
                echo "floodsd dpdk: '$slave' is no longer a member of '$iface'." >&2
                return 1
            fi
        done
    fi

    local rows=() pcis=() drivers=() nodes=() pci curdrv nicnode row address previous flags
    for slave in "${members[@]}"; do
        row=$(_fd_dpdk_device "$slave") || return 1
        read -r pci curdrv nicnode <<< "$row"
        for previous in "${rows[@]}"; do
            if [ "${previous%% *}" = "$pci" ]; then
                echo "floodsd dpdk: selected interfaces share PCI device '$pci'." >&2
                return 1
            fi
        done
        rows+=("$pci $slave $curdrv $nicnode")
        case "$curdrv" in
            mlx5_core|mlx5)
                flags=$(cat "/sys/class/net/$slave/flags") || return 1
                if ! [[ "$flags" =~ ^0x[0-9a-fA-F]+$ ]] || [ "$((flags & 1))" -eq 0 ]; then
                    echo "floodsd dpdk: mlx5 interface '$slave' must already be administratively up." >&2
                    return 1
                fi
                ;;
            *)
                master=$(readlink "/sys/class/net/$slave/master" 2>/dev/null) || master=""
                address=$(ip -o addr show dev "$slave" scope global) || return 1
                if [ "${#members[@]}" -ne 1 ] || [ -n "$master" ] || [ -n "$address" ]; then
                    echo "floodsd dpdk: VFIO requires a dedicated interface with no host addresses or master." >&2
                    return 1
                fi
                ;;
        esac
    done
    # Match DPDK's PCI enumeration order when assigning port numbers.
    members=()
    while read -r pci slave curdrv nicnode; do
        pcis+=("$pci"); members+=("$slave"); drivers+=("$curdrv"); nodes+=("$nicnode")
    done < <(printf '%s\n' "${rows[@]}" | LC_ALL=C sort)

    ifip=$(ip -4 -o addr show dev "$sourceif" | awk 'NR==1 {split($4, ip, "/"); print ip[1]}') || return 1
    local curcores ntx plan lcores map cpus est
    curcores=$(_floodsd_get dpdkcores); curcores=${curcores:-${#members[@]}}
    echo "DPDK uses 1 control core, ${#members[@]} RX core(s), and the requested TX cores."
    read -rp "How many TX (generation) cores? [${curcores}] " ntx
    ntx=${ntx:-$curcores}
    if ! [[ "$ntx" =~ ^[0-9]+$ ]] || [ "$ntx" -lt 1 ]; then
        echo "floodsd dpdk: invalid TX core count '$ntx'." >&2
        return 1
    fi
    plan=$(_fd_lcore_plan "floodsd dpdk" "$ntx" "${#members[@]}") || return 1
    read -r lcores map cpus est <<< "$plan"
    local mappings=() mapping_args=() mapping
    IFS=, read -r -a mappings <<< "$map"
    for mapping in "${mappings[@]}"; do
        mapping_args+=(-m "$mapping")
    done
    _floodsd_ensure_dpdk || return 1
    _floodsd_set dpdkcores "$ntx" || return 1
    if [ -n "$selection" ]; then
        _floodsd_set dpdkslave "$selection" || return 1
    fi
    local port pci_list="" require_mlx5=0 eal=()
    for ((port=0; port<${#members[@]}; port++)); do
        row=$(_fd_dpdk_device "${members[port]}") || return 1
        if [ "$row" != "${pcis[port]} ${drivers[port]} ${nodes[port]}" ]; then
            echo "floodsd dpdk: device changed during setup." >&2
            return 1
        fi
        pci_list+="${pci_list:+,}${pcis[port]}"
        case "${drivers[port]}" in
            mlx5_core|mlx5)
                # HWS avoids the legacy probe-time receive-rule tests.
                eal+=(-a "${pcis[port]},dv_flow_en=2,dv_esw_en=0,fdb_def_rule_en=0,lacp_by_user=1,dv_xmeta_en=0")
                require_mlx5=1
                ;;
            *) eal+=(-a "${pcis[port]}") ;;
        esac
        _fd_check_numa "floodsd dpdk" "${members[port]}" "${nodes[port]}" "$cpus"
        echo "Port $port, ${members[port]} (${pcis[port]}, ${drivers[port]})"
    done
    if [ "$require_mlx5" = 1 ]; then
        local dpdk_version
        dpdk_version=$(_floodsd_dpdk_pkg_config --modversion libdpdk) || return 1
        case "$dpdk_version" in
            25.11|25.11.*) ;;
            *) echo "floodsd dpdk: zero receive rules has only been audited for DPDK 25.11, found $dpdk_version." >&2; return 1 ;;
        esac
    fi
    echo "DPDK CPUs $cpus, queue mapping $map"

    # Source-port rotation: sweep FLOOD_SPORT .. FLOOD_SPORT+FLOOD_SPORT_CNT-1
    # so the target's NIC hashes the flood across its RX queues / net tiles.
    # DPDK pktgen only varies fields in "range" mode, and range mode ignores
    # the plain `set` values — so every field must be given as a range (a
    # min==max==inc-0 range is a fixed field). sport increments by 1 and wraps
    # at max, giving an even round-robin across the port range.
    local sport_cnt
    sport_cnt=$(_fd_sport_cnt)
    local sport_lo=$FLOOD_SPORT sport_hi=$((FLOOD_SPORT + sport_cnt - 1))
    local cmds="$FLOODSD_DPDK_CMDS"
    mkdir -p "$(dirname "$cmds")" || return 1
    for ((port=0; port<${#members[@]}; port++)); do
        cat <<EOF
disable $port vlan
range $port dst mac start $destmac
range $port dst ip start $destip
range $port dst ip min $destip
range $port dst ip max $destip
range $port dst ip inc 0.0.0.0
range $port src ip start ${ifip:-0.0.0.0}
range $port src ip min ${ifip:-0.0.0.0}
range $port src ip max ${ifip:-0.0.0.0}
range $port src ip inc 0.0.0.0
range $port proto udp
range $port dst port start $FLOOD_DPORT
range $port dst port min $FLOOD_DPORT
range $port dst port max $FLOOD_DPORT
range $port dst port inc 0
range $port src port start $sport_lo
range $port src port min $sport_lo
range $port src port max $sport_hi
range $port src port inc 1
range $port size start 64
range $port size min 64
range $port size max 64
range $port size inc 0
enable $port range
EOF
    done > "$cmds" || return 1

    _fd_reserve_hugepages "$ntx" || return 1
    case "${drivers[0]}" in
        mlx5_core|mlx5) ;;
        *) _fd_vfio_bind floodsd "${members[0]}" "${pcis[0]}" "${drivers[0]}" "$FLOODSD_VFIO_STATE" "" "$ifip" || return 1 ;;
    esac

    echo "Launching pktgen -> $destip:$FLOOD_DPORT ($destmac)..."
    echo "(run 'start all' yourself when ready.)"
    # Absolute path (not just "pktgen"): sudo's secure_path typically strips
    # ~/.local/bin from PATH. LD_LIBRARY_PATH is passed explicitly through
    # env since libpktgen.so lives in ~/.local/lib, outside the system
    # linker cache (sudo would otherwise reset the environment).
    local dpdk_libdir
    dpdk_libdir=$(_floodsd_dpdk_pkg_config --variable=libdir libdpdk) || return 1
    sudo env LD_LIBRARY_PATH="$dpdk_libdir:$PKTGEN_PREFIX/lib" FLOODSD_DPDK_PCI="$pci_list" FLOODSD_DPDK_MLX5="$require_mlx5" "$PKTGEN_BIN" \
        --lcores "$lcores" -n 4 "${eal[@]}" --main-lcore 0 -- "${mapping_args[@]}" -f "$cmds"
}

# floodsd restore: undo whatever `floodsd dpdk` did to hand the NIC over —
# rebind vfio-pci NICs to their kernel driver (see _fd_vfio_restore), and/or
# re-add a NIC removed from its bond by an older version.
_floodsd_restore() {
    local attempted=0 failed=0
    if [ -f "$FLOODSD_VFIO_STATE" ]; then
        attempted=1
        _fd_vfio_restore "floodsd restore" "$FLOODSD_VFIO_STATE" || failed=1
    fi
    if [ -f "$FLOODSD_BOND_STATE" ]; then
        attempted=1
        _fd_bond_reattach || failed=1
    fi
    if [ "$attempted" = 0 ]; then
        echo "floodsd restore: nothing to restore (no vfio-pci bind or bond detach recorded)."
        return 1
    fi
    [ "$failed" = 1 ] && return 1
    return 0
}

# floodsd diagnose: read-only health check for a saved (or in-progress)
# target — link state, IP config, resolved next hop + live neighbor entry,
# rp_filter, python3 presence, and a best-effort grep of local firewall
# rules for the configured source port. Entirely opt-in — nothing else in
# floodsd calls this, so it never adds noise unless you run it yourself.
_floodsd_diagnose() {
    _fd_parse_multiport "$@"
    local iface destip destmac sport spcnt
    iface=$(_floodsd_get if); destip=$(_floodsd_get destip); destmac=$(_floodsd_get destmac)
    sport=$(_floodsd_get sport); sport=${sport:-$FLOOD_SPORT}
    spcnt=$(_fd_sport_cnt)

    echo "== floodsd diagnose =="
    if [ "$spcnt" -gt 1 ]; then
        echo "Source port: $sport..$((sport + spcnt - 1)) (rotated, --multiport; dport $FLOOD_DPORT)"
    else
        echo "Source port: $sport (single; dport $FLOOD_DPORT — pass --multiport to see the rotation range)"
    fi
    command -v python3 >/dev/null 2>&1 || echo "  WARNING: python3 not found — 'floodsd setup' probes need it."

    if [ -z "$iface" ]; then
        echo "No target configured yet — run 'floodsd setup' first for interface-specific checks."
        return 0
    fi

    echo
    echo "Interface: $iface"
    if ! ip link show "$iface" >/dev/null 2>&1; then
        echo "  NOT FOUND — was it rebound to vfio-pci, or pulled into/out of a bond? Check 'floodsd restore'."
        return 1
    fi
    local state; state=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null)
    echo "  operstate: ${state:-unknown}$( [ "$state" != up ] && echo '  <-- not up' )"
    ip -4 -o addr show dev "$iface" | awk '{print "  addr: "$4}'
    local bondtag; bondtag=$(_fd_bond_tag "$iface")
    [ -n "$bondtag" ] && echo "  $bondtag"

    local rpall rpif rpeff
    rpall=$(cat /proc/sys/net/ipv4/conf/all/rp_filter 2>/dev/null)
    rpif=$(cat "/proc/sys/net/ipv4/conf/$iface/rp_filter" 2>/dev/null)
    # The kernel applies max(all, per-interface), not just the per-interface
    # value — e.g. all=1 with iface=0 is still strict mode.
    rpeff=$(( ${rpall:-0} > ${rpif:-0} ? ${rpall:-0} : ${rpif:-0} ))
    echo "  rp_filter: all=${rpall:-?} $iface=${rpif:-?}$( [ "$rpeff" = 1 ] && echo '  <-- effective mode is strict; asymmetric-routed replies may get dropped' )"

    if [ -n "$destip" ]; then
        echo
        echo "Target: $destip (saved MAC: ${destmac:-none})"
        local nexthop; nexthop=$(_fd_nexthop_ip "$iface" "$destip")
        if [ -z "$nexthop" ]; then
            echo "  no route to $destip out $iface"
        else
            [ "$nexthop" != "$destip" ] && echo "  routed via $nexthop (not on-link)" || echo "  on-link"
            local live; live=$(ip neigh show "$nexthop" dev "$iface" 2>/dev/null)
            echo "  neighbor entry: ${live:-none}"
        fi
    fi

    if command -v iptables >/dev/null 2>&1; then
        local hits; hits=$(sudo iptables -S OUTPUT 2>/dev/null | grep -c -- "$sport")
        [ "${hits:-0}" -gt 0 ] && echo "  NOTE: iptables OUTPUT has $hits rule(s) mentioning '$sport' (may be coincidental — verify it ACCEPTs this traffic)"
    fi
}

floodsd() {
    case "${1:-}" in
        setup)         shift; _floodsd_setup "$@";         return ;;
        setup-srcport) shift; _floodsd_setup_srcport "$@"; return ;;
        diagnose)      shift; _floodsd_diagnose "$@";      return ;;
        dpdk)          shift; _floodsd_dpdk "$@";          return ;;
        kernel)        shift; _floodsd_kernel "$@";        return ;;
        stop)          shift; _floodsd_stop "$@";          return ;;
        restore)       shift; _floodsd_restore "$@";       return ;;
        *)
            echo "Usage: floodsd setup [--multiport] | setup-srcport | diagnose [--multiport] | dpdk [shred] | kernel [shred] [--multiport] | stop | restore"
            return 1
            ;;
    esac
}

floodsd "$@"
exit $?
